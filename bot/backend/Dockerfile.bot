FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 65532 --user-group appuser

COPY requirements-bot.txt .
RUN pip install --no-cache-dir -r requirements-bot.txt

COPY --chown=appuser:appuser bot.py ./bot.py
COPY --chown=appuser:appuser monkeys ./monkeys

RUN mkdir -p /app/avatar && chown -R appuser:appuser /app/avatar

USER appuser

CMD ["python", "bot.py"]
