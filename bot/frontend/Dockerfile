FROM node:22-alpine AS builder

WORKDIR /app

ARG VITE_SUBSCRIPTION_URL=""
ARG VITE_SUBSCRIPTION_BONUS_ENERGY="20"
ARG VITE_SUBSCRIPTION_TITLE=""
ARG VITE_APP_MARKET="portugal"
ARG VITE_APP_TITLE=""
ARG VITE_REFERRAL_BOT_URL=""
ARG VITE_REFERRAL_BOT_USERNAME=""

ENV VITE_SUBSCRIPTION_URL=$VITE_SUBSCRIPTION_URL
ENV VITE_SUBSCRIPTION_BONUS_ENERGY=$VITE_SUBSCRIPTION_BONUS_ENERGY
ENV VITE_SUBSCRIPTION_TITLE=$VITE_SUBSCRIPTION_TITLE
ENV VITE_APP_MARKET=$VITE_APP_MARKET
ENV VITE_APP_TITLE=$VITE_APP_TITLE
ENV VITE_REFERRAL_BOT_URL=$VITE_REFERRAL_BOT_URL
ENV VITE_REFERRAL_BOT_USERNAME=$VITE_REFERRAL_BOT_USERNAME

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080
